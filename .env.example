APP_NAME=AutoReel AI
SECRET_KEY=change-this-to-a-long-random-secret
DATABASE_URL=sqlite:///./autoreel.db
COOKIE_SECURE=false
PUBLIC_BASE_URL=http://localhost:8000
STORAGE_DIR=./storage
INSTAGRAM_PUBLISH_ENABLED=false
META_API_VERSION=v24.0
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/instagram/callback

# --- AI content provider ---
# "mock" (default, no credentials needed), "custom" (your own OpenAI-compatible AI), or "gemini"
AI_PROVIDER=mock

# Your own OpenAI-compatible AI (Ollama, vLLM, LM Studio, TGI, LiteLLM, ...)
CUSTOM_AI_BASE_URL=http://localhost:11434/v1
CUSTOM_AI_MODEL=llama3.1
CUSTOM_AI_API_KEY=
CUSTOM_AI_JSON_MODE=true

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

